{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hddstore",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-26",
  "observability": {
    "enabled": true
  },
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hddstore-reviews",
      "database_id": "628384d7-befd-49e0-a710-4b5c5d03d4ac",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 6 * * *"]
  }
}